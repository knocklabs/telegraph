{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@knocklabs/typescript-config/react-library.json",
  "display": "@telegraph/checkbox",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "vitest.*": ["../../vitest/*"]
    },
    "types": ["@testing-library/jest-dom", "node"],
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test-d.tsx",
    "dist",
    "node_modules"
  ]
}
