{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "display": "@telegraph/checkbox (typecheck)",
  "compilerOptions": {
    // Tests import the shared axe helper from the repo root, which sits
    // outside the package's build `rootDir`. Typechecking is emit-free, so
    // widening the root here is safe and keeps `tsconfig.json` accurate for
    // the actual build.
    "rootDir": "../..",
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
